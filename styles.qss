    QMainWindow {
        background-color: #f5f5f5;
    }
    QGroupBox {
        font-weight: bold;
        border: 1px solid #ccc;
        border-radius: 5px;
        margin-top: 10px;
        padding-top: 10px;
    }
    QGroupBox::title {
        subcontrol-origin: margin;
        left: 10px;
        padding: 0 5px 0 5px;
    }
    QPushButton {
        background-color: #3E5F8A;
        color: white;
        border: none;
        border-radius: 5px;
        padding: 8px 16px;
        font-size: 12px;
    }
    QPushButton:hover {
        background-color: #4E7AAA;
    }
    QPushButton:pressed {
        background-color: #2E4A6A;
    }
    QPushButton#dangerButton {
        background-color: #f44336;
    }
    QPushButton#dangerButton:hover {
        background-color: #da190b;
    }
    QLineEdit {
        border: 1px solid #ccc;
        border-radius: 4px;
        padding: 5px;
    }
    QLineEdit:focus {
        border-color: #3E5F8A;
    }
    QComboBox {
        border: 1px solid #ccc;
        border-radius: 5px;
        padding: 5px;
    }
